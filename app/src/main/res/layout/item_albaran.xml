<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Código de Transporte (AT) -->
        <TextView
            android:id="@+id/txtCodigoTransporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_at"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <!-- Código de Cliente (AC) -->
        <TextView
            android:id="@+id/txtCodigoCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_ac"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <!-- Contenedor para fotos y fecha (lado a lado) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Total de Fotos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#FF6B6B"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/icon_camera" />

                <TextView
                    android:id="@+id/txtTotalFotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_fotos"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B6B" />
            </LinearLayout>

            <!-- Fecha de creación -->
            <TextView
                android:id="@+id/txtFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_fecha"
                android:textSize="12sp"
                android:textColor="#999999" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>