<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- 1. VISTA DE LA CÁMARA (Siempre de primero para que sirva de fondo de pantalla) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. BOTÓN VOLVER (Ahora sí se dibuja encima de la cámara) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Volver"
        app:backgroundTint="@color/rodavigo_red"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. INDICADOR DE COLA DE SUBIDA -->
    <LinearLayout
        android:id="@+id/layoutSync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_status_sync"
        android:elevation="6dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgSyncIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/stat_notify_sync"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/txtPendientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. BOTÓN SUBIR FOTOS (Se apila debajo del indicador de sync en la esquina derecha) -->
    <Button
        android:id="@+id/btnSubirFotos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subir (0)"
        app:backgroundTint="@color/rodavigo_red"
        android:layout_margin="16dp"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/layoutSync"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 5. BOTÓN DE CAPTURA (Sustituto de gatillo físico, flota sobre el fondo) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCapturar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="CAPTURAR FOTO"
        android:textSize="16sp"
        android:padding="16dp"
        android:enabled="false"
        app:layout_constraintBottom_toTopOf="@id/txtResultado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 6. TEXTO DE RESULTADO INFERIOR (Con fondo semitransparente oscuro) -->
    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Apunta a un código QR"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#99000000"
        android:padding="24dp"
        android:gravity="center"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>